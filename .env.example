# ===== এনভায়রনমেন্ট ভ্যারিয়েবল =====
# Vercel-এ Project → Settings → Environment Variables-এ এগুলো সেট করুন।
# লোকাল ডেভেলপমেন্টের জন্য এই ফাইলটি .env.local-এ কপি করুন:
#   cp .env.example .env.local

# --- MongoDB (Atlas বা লোকাল) ---
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nextmart-db?retryWrites=true&w=majority
# লোকাল: mongodb://127.0.0.1:27017/nextmart
MONGODB_URI="mongodb://127.0.0.1:27017/nextmart"

# --- Better Auth ---
# সিক্রেট বানাতে: npx @better-auth/cli secret
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"

# ডিপ্লয় করা সাইটের ঠিকানা (প্রোডাকশনে Vercel-এর URL দিন)
BETTER_AUTH_URL="http://localhost:3000"

# --- ক্লায়েন্ট সাইড বেজ URL (বিল্ড টাইমে বেক করে যায়) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- ইমেইল ভেরিফিকেশন (ঐচ্ছিক) ---
# true করলে ভেরিফাই না করে লগইন বন্ধ হবে
REQUIRE_EMAIL_VERIFICATION="false"
